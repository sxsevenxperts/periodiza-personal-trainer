# URL do projeto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica (anon). Pode ir para o browser. Protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Chave de service role. NUNCA exponha no browser nem versione o .env.
# Usada apenas por scripts de servidor (npm run seed) e rotinas administrativas.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
